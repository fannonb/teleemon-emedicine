# Copy to .env.local (scripts) — never commit real credentials.
MEDPLUM_BASE_URL=http://localhost:8103/
# Used once by `npm run setup` to create the service client; later runs use the client below.
MEDPLUM_ADMIN_EMAIL=admin@example.com
MEDPLUM_ADMIN_PASSWORD=medplum_admin
# Written by `npm run setup`.
TELEEMON_CLIENT_ID=
TELEEMON_CLIENT_SECRET=

# Phase 4 service only; never add OPENAI_ or SCRIBE_ to Vite envPrefix.
OPENAI_API_KEY=
SCRIBE_PORT=3111
SCRIBE_HOST=127.0.0.1
SCRIBE_ALLOWED_ORIGINS=http://localhost:3100
SCRIBE_TRANSCRIPTION_MODEL=gpt-transcribe
SCRIBE_DRAFT_MODEL=gpt-6.1-sol
# Default is synthetic-only. Enable only after contracts, privacy/storage and retention gates.
SCRIBE_ALLOW_PHI=false
SCRIBE_CLINICAL_APPROVED=false

# Phase 8 – revenue cycle
# Shared secret for service-to-ledger calls (worker, portal). `npm run setup` creates it.
LEDGER_INTERNAL_TOKEN=
# Ledger service and its PostgreSQL (defaults shown).
LEDGER_URL=http://127.0.0.1:3130
LEDGER_PORT=3130
LEDGER_PG_HOST=127.0.0.1
LEDGER_PG_PORT=5439
LEDGER_PG_DATABASE=teleemon_ledger
LEDGER_ALLOWED_ORIGINS=http://localhost:3100
# Clearinghouse: leave empty for the mock test payer. A Stedi test key switches to Stedi (unverified until then).
STEDI_API_KEY=
STEDI_TEST_MODE=true

# Phase 7 – telehealth meetings (Google Meet). Every confirmed video appointment is given a join link
# by the worker. "sandbox" mints a synthetic link and calls nothing; "google" creates a real Meet link
# through a Workspace service account (Calendar API, conferenceData). The link is hidden from the
# patient until check-in and shared with the provider from the same appointment.
MEET_VENDOR=sandbox
# Either the full service-account JSON, or the two fields below (use \n for newlines in the key).
GOOGLE_MEET_SERVICE_ACCOUNT_JSON=
GOOGLE_MEET_CLIENT_EMAIL=
GOOGLE_MEET_PRIVATE_KEY=
# Calendar that owns the meeting, and the Workspace user a service account impersonates.
GOOGLE_MEET_CALENDAR_ID=primary
GOOGLE_MEET_IMPERSONATE=

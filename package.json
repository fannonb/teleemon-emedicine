{
  "name": "teleemon",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/staff",
    "build": "npm run build -w apps/staff",
    "typecheck": "tsc -p scripts/tsconfig.json && tsc -p packages/core/tsconfig.json && tsc -p bots/tsconfig.json && tsc -p services/worker/tsconfig.json && tsc -p services/scribe/tsconfig.json && tsc -p services/portal/tsconfig.json && tsc -p services/ledger/tsconfig.json && npm run typecheck -w apps/staff && npm run typecheck -w apps/portal",
    "setup": "tsx scripts/setup.ts",
    "seed": "tsx scripts/seed.ts",
    "bots:build": "node bots/build.mjs",
    "verify:phase1": "tsx scripts/verify-phase1.ts",
    "test:phase1": "tsx --test scripts/phase1-regressions.test.ts",
    "test:phase3": "tsx --test scripts/phase3-regressions.test.ts",
    "worker": "tsx services/worker/src/index.ts",
    "scribe": "tsx services/scribe/src/index.ts",
    "scribe:retention": "tsx scripts/scribe-retention.ts",
    "test:phase4": "tsx --test scripts/phase4-regressions.test.ts",
    "verify:phase4": "tsx scripts/verify-phase4.ts",
    "verify:phase2": "tsx scripts/verify-phase2.ts",
    "verify:phase3": "tsx scripts/verify-phase3.ts",
    "test:phase5": "tsx --test scripts/phase5-regressions.test.ts",
    "verify:phase5": "tsx scripts/verify-phase5.ts",
    "fax:simulate": "tsx scripts/fax-simulate.ts",
    "test:phase6": "tsx --test scripts/phase6-regressions.test.ts",
    "verify:phase6": "tsx scripts/verify-phase6.ts",
    "dev:portal": "npm run dev -w apps/portal",
    "build:portal": "npm run build -w apps/portal",
    "portal": "tsx services/portal/src/index.ts",
    "portal:demo": "tsx scripts/portal-demo.ts",
    "test:phase7": "tsx --test scripts/phase7-regressions.test.ts",
    "verify:phase7": "tsx scripts/verify-phase7.ts",
    "test:meet": "tsx --test scripts/meet.test.ts",
    "test:location": "tsx --test scripts/checkin-location.test.ts",
    "test:phase8": "tsx --test scripts/phase8-regressions.test.ts scripts/phase8-bots.test.ts scripts/phase8-portal.test.ts scripts/phase8-access-settings.test.ts scripts/phase8-reconciliation.test.ts",
    "ledger:schema": "tsx scripts/ledger-schema.ts",
    "ledger": "tsx services/ledger/src/index.ts",
    "test:ledger": "tsx --test scripts/ledger-service.test.ts scripts/ledger-routes.test.ts",
    "verify:phase8": "tsx scripts/verify-phase8.ts",
    "test:phase9": "tsx --test scripts/phase9-*.test.ts",
    "verify:phase9": "tsx scripts/verify-phase9.ts",
    "migration:validate": "tsx scripts/migration-validate.ts",
    "migration:rehearse": "tsx scripts/migration-rehearse.ts",
    "recovery:rehearse": "tsx scripts/recovery-rehearse.ts",
    "render:env": "node render/print-env.mjs"
  },
  "devDependencies": {
    "@medplum/core": "5.2.4",
    "@medplum/fhirtypes": "5.2.4",
    "@teleemon/core": "*",
    "@types/node": "22.20.5",
    "@types/pg": "^8.11.10",
    "esbuild": "0.25.12",
    "pg": "^8.13.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}

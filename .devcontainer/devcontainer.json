{
  "name": "Teleemon synthetic demo backend",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-22-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "22.23.3"
    },
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "enableNonRootDocker": true,
      "installDockerBuildx": true
    },
    "ghcr.io/devcontainers/features/sshd:1": {
      "version": "latest"
    }
  },
  "hostRequirements": {
    "cpus": 2,
    "memory": "8gb",
    "storage": "32gb"
  },
  "forwardPorts": [3400],
  "portsAttributes": {
    "3400": {
      "label": "Teleemon demo API gateway",
      "visibility": "public",
      "onAutoForward": "notify"
    }
  },
  "otherPortsAttributes": {
    "visibility": "private",
    "onAutoForward": "ignore"
  },
  "postCreateCommand": "npm ci --include=dev && npm run bots:build",
  "postStartCommand": "node render/codespaces/start.mjs"
}
